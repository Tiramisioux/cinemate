{
  "$schema": "../../settings.schema.json",
  "system": {
    "welcome": {
      "show": true,
      "message": "THIS IS A COOL MACHINE",
      "image": null
    },
    "wifi_hotspot": {
      "name": "CinePi",
      "password": "11111111",
      "enabled": true
    },
    "storage": {
      "auto_preroll": true
    }
  },
  "sensors": {
    "raw_buffer_count": 0,
    "record_policy": "follow_preview",
    "cam0": {
      "geometry": {
        "rotate_180": false,
        "horizontal_flip": false,
        "vertical_flip": false
      },
      "output": {
        "hdmi_port": 0
      },
      "override_camera_name": false,
      "camera_name": "",
      "log_encode": false
    },
    "cam1": {
      "geometry": {
        "rotate_180": false,
        "horizontal_flip": false,
        "vertical_flip": false
      },
      "output": {
        "hdmi_port": 1
      },
      "override_camera_name": false,
      "camera_name": "",
      "log_encode": false
    },
    "database_file": "resources/sensors.json"
  },
  "settings": {
    "conform_frame_rate": 25,
    "light_hz": [50, 60],
    "sync_tolerances": {
      "live_sync_warning_frames": 2,
      "final_sync_analysis_frames": 1
    }
  },
  "arrays": {
    "iso": {
      "steps": [100, 200, 400, 640, 800, 1200, 1600, 2500, 3200],
      "free": false,
      "free_increment": 100
    },
    "shutter_a": {
      "steps": [1, 45, 90, 135, 172.8, 180, 225, 270, 315, 346.6, 360],
      "free": false,
      "free_increment": 1,
      "sync_increment": 0.1
    },
    "fps": {
      "steps": [1, 2, 4, 8, 12, 16, 18, 24, 25, 33, 40, 50],
      "free": true,
      "free_increment": 1
    },
    "wb": {
      "steps": [3200, 4400, 5600],
      "free": false,
      "free_increment": 100
    },
    "hdr_threshold_low": {
      "steps": [0, 512, 1024, 1536, 2048, 2560, 3072, 3584, 4095],
      "free": false,
      "free_increment": 16
    },
    "hdr_threshold_high": {
      "steps": [0, 512, 1024, 1536, 2048, 2560, 3072, 3584, 4095],
      "free": false,
      "free_increment": 16
    },
    "hdr_blend": {
      "steps": [0, 1, 2, 3, 4, 5, 6, 7, 8],
      "free": false,
      "free_increment": 1
    },
    "hdr_gain_adder": {
      "steps": [0, 1, 2, 3, 4, 5],
      "free": false,
      "free_increment": 1
    }
  },
  "image_capture": {
    "k_steps": [1.5, 2, 4],
    "bit_depths": [10, 12],
    "hdr": {
      "sdr": true,
      "imx585_clear_hdr": true
    },
    "custom_modes": {}
  },
  "audio_capture": {
    "24bit": {
      "capture_gain_db": 6.0,
      "timecode_offset_frames": -1
    },
    "16bit": {
      "capture_gain_db": 6.0,
      "timecode_offset_frames": 0
    }
  },
  "hdmi_display": {
    "width": 1920,
    "height": 1080,
    "mirror_to_both_ports": false,
    "overlays": {
      "buffer_vu_meter": false,
      "vu_meter_hatch_lines": true
    },
    "preview": {
      "default_zoom": 1.0,
      "zoom_steps": [1.0, 2.0],
      "default_hdmi_source": "both",
      "anamorphic": {
        "default_factor": 1,
        "steps": [1, 1.33, 2.0]
      }
    }
  },
  "hardware_controls": {
    "buttons": [
      {
        "pin": 7,
        "pull_up": true,
        "debounce_time": 0.1,
        "press_action": { "method": "rec" }
      },
      {
        "pin": 10,
        "pull_up": true,
        "debounce_time": 0.1,
        "press_action": { "method": "rec" }
      },
      {
        "pin": 13,
        "pull_up": false,
        "debounce_time": 0.1,
        "press_action": "None",
        "single_click_action": { "method": "set_resolution" },
        "double_click_action": { "method": "restart_cinemate" },
        "triple_click_action": { "method": "reboot" },
        "hold_action": { "method": "toggle_mount" }
      }
    ],
    "two_way_switches": [
      {
        "pin": 24,
        "state_on_action": { "method": "set_zoom", "args": [2] },
        "state_off_action": { "method": "set_zoom", "args": [1] }
      },
      {
        "pin": 22,
        "state_on_action": { "method": "set_shutter_a_sync_mode", "args": [1] },
        "state_off_action": { "method": "set_shutter_a_sync_mode", "args": [0] }
      }
    ],
    "rotary_encoders": [
      {
        "enabled": false,
        "clk_pin": 9,
        "dt_pin": 11,
        "button_pin": 10,
        "pull_up": true,
        "debounce_time": 0.05,
        "button_actions": {
          "press_action": { "method": "set_iso_lock" },
          "hold_action": "None"
        },
        "encoder_actions": {
          "rotate_clockwise": { "method": "inc_iso" },
          "rotate_counterclockwise": { "method": "dec_iso" }
        }
      }
    ]
  },
  "input_peripherals": {
    "pots": [
      { "channel": "None", "setting": "iso" },
      { "channel": "None", "setting": "shutter_a" },
      { "channel": "None", "setting": "fps" },
      { "channel": "None", "setting": "wb" }
    ],
    "quad_rotary_controller": {
      "enabled": false,
      "encoders": {
        "0": {
          "setting_name": "iso",
          "button": {
            "press_action": { "method": "set_zoom" },
            "hold_action": { "method": "safe_shutdown" }
          }
        },
        "1": {
          "setting_name": "shutter_a",
          "button": {
            "press_action": { "method": "set_shutter_a_sync_mode" }
          }
        },
        "2": {
          "setting_name": "fps",
          "button": {
            "press_action": { "method": "set_fps_double" }
          }
        },
        "3": {
          "setting_name": "wb",
          "button": {
            "press_action": "None",
            "single_click_action": { "method": "set_resolution" },
            "double_click_action": { "method": "restart_cinemate" },
            "triple_click_action": { "method": "reboot" },
            "hold_action": { "method": "toggle_mount" }
          }
        }
      }
    }
  },
  "hardware_outputs": {
    "rec_out_pin": [21],
    "rec_tone": {
      "pin": [18],
      "frequency_hz": 1000,
      "duty_cycle": 50,
      "relay_drop_frames": false
    }
  },
  "output_peripherals": {
    "oled": {
      "enabled": false,
      "width": 128,
      "height": 64,
      "font_size": 20,
      "values": ["iso", "tc_cam0", "RECORDING_TC"]
    }
  }
}
