{
  "$schema": "../../settings.schema.json",
  "system": {
    "welcome": {
      "show": true,
      "message": "THIS IS A COOL MACHINE",
      "image": null
    },
    "wifi_hotspot": {
      "name": "CinePi",
      "password": "11111111",
      "enabled": true
    },
    "storage": {
      "auto_preroll": true
    }
  },
  "sensors": {
    "raw_buffer_count": 0,
    "record_policy": "follow_preview",
    "cam0": {
      "geometry": {
        "rotate_180": false,
        "horizontal_flip": false,
        "vertical_flip": false
      },
      "output": {
        "hdmi_port": 0
      },
      "override_camera_name": false,
      "camera_name": "",
      "log_encode": false
    },
    "cam1": {
      "geometry": {
        "rotate_180": false,
        "horizontal_flip": false,
        "vertical_flip": false
      },
      "output": {
        "hdmi_port": 1
      },
      "override_camera_name": false,
      "camera_name": "",
      "log_encode": false
    },
    "database_file": "resources/sensors.json"
  },
  "settings": {
    "conform_frame_rate": 25,
    "light_hz": [50, 60],
    "sync_tolerances": {
      "live_sync_warning_frames": 5,
      "live_sync_startup_guard_frames": 10,
      "final_sync_analysis_frames": 1,
      "tc_drop_jitter_frames": 1
    }
  },
  "arrays": {
    "iso": {
      "steps": [100, 200, 400, 640, 800, 1200, 1600, 2500, 3200],
      "free": false,
      "free_increment": 100
    },
    "shutter_a": {
      "steps": [1, 45, 90, 135, 172.8, 180, 225, 270, 315, 346.6, 360],
      "free": true,
      "free_increment": 1,
      "sync_increment": 0.1
    },
    "fps": {
      "steps": [25, 33, 50],
      "free": false,
      "free_increment": 1
    },
    "wb": {
      "steps": [3200, 4400, 5600],
      "free": true,
      "free_increment": 100
    },
    "hdr_threshold_low": {
      "steps": [0, 512, 1024, 1536, 2048, 2560, 3072, 3584, 4095],
      "free": false,
      "free_increment": 16
    },
    "hdr_threshold_high": {
      "steps": [0, 512, 1024, 1536, 2048, 2560, 3072, 3584, 4095],
      "free": false,
      "free_increment": 16
    },
    "hdr_blend": {
      "steps": [0, 1, 2, 3, 4, 5, 6, 7, 8],
      "free": false,
      "free_increment": 1
    },
    "hdr_gain_adder": {
      "steps": [0, 1, 2, 3, 4, 5],
      "free": false,
      "free_increment": 1
    }
  },
  "image_capture": {
    "k_steps": [1.5, 2, 3, 4],
    "bit_depths": [10, 12, 16],
    "hdr": {
      "sdr": true,
      "imx585_clear_hdr": true,
      // 12-bit ClearHDR is HIDDEN by default. The modes still exist in the
      // driver and every line of code that serves them is still here -- flip
      // this to true to get them back for experiment. They are hidden because
      // on this sensor they do not earn their place: the HG/LG merge stops
      // reaching the top of the container above analogue gain code ~60 (about
      // ISO 800), so highlight range collapses at the ISOs people actually
      // shoot, while 16-bit ClearHDR holds up across the whole ISO range. The
      // 12-bit modes also carry the compander, a full-frame CPU preview
      // re-render, and the clamp artefacts that come with both.
      //
      // NOTE: hiding them RENUMBERS the remaining modes -- 16-bit ClearHDR HD
      // and 4K move from 5 and 6 to 3 and 4. A sensor_mode saved in Redis is
      // re-resolved by what it actually was, not by its index, so a camera
      // does not silently wake up in a different capture.
      "imx585_clear_hdr_12bit": false,
      // Adds the HD (1920x1100, binned) 16-bit ClearHDR mode. OFF by default:
      // its blown highlights render pink, because CineMate ships without the
      // preview-side correction for the sensor's HG/LG merge clamp. Turn it on
      // if you want the mode and can live with that -- the recorded DNG is the
      // same either way, it is the preview and the DNG thumbnail that go pink.
      // The 4K ClearHDR mode is unaffected and stays on.
      "imx585_clear_hdr_16bit_hd": false,
      // null leaves both thresholds unwritten, so the driver keeps its own pair.
      "threshold_low": null,
      "threshold_high": null,
      // 5 = HG 1/16. The driver's own default is 0, which leaves the ClearHDR
      // combiner clamped near the black level -- the flat pedestal condition.
      "blend": 5,
      "gain_adder": 1,
      // Highest ISO offered WHILE A CLEARHDR MODE IS ENGAGED -- SDR modes are
      // never capped. On by default; set null to lift it.
      //
      // ClearHDR caps analogue gain at code 80 in the driver, which CineMate's
      // ISO steps reach at about ISO 1585. Measured on the rig in 16-bit
      // ClearHDR: ISO 1600, 2500 and 3200 all map to gain code 80 and record
      // the SAME exposure. Above the cap only the preview brightens, because
      // libcamera's AGC makes up the difference as ISP digital gain on the
      // display path -- so the monitor shows light the file never received,
      // and exposure judged from it is wrong.
      //
      // The 1600 step is kept and lands on 1585, shown green in both GUIs to
      // say the camera is holding it. 2500 and 3200 are dropped.
      "iso_max": 1585,
      "self_heal": false
    },
    // By default DNGs carry a small preview image, used by the Playback
    // pane for renderless playback. Colour JPEG 628x360 -- about 10-25 KB
    // per frame, +4.0 ms per frame (+18%). Disable to slightly increase
    // write speed and reduce cpu load during recording (disables web GUI
    // playback). "off" / "mono" / "colour" / "jpeg" (or 0-3) -- see
    // settings.jsonc's comment for the cost of each.
    "thumbnail": "jpeg",
    // Right-shift of the lores plane before the thumbnail is written --
    // see settings.jsonc's comment.
    "thumbnail_size": 1,
    "custom_modes": {}
  },
  "audio_capture": {
    "24bit": {
      "capture_gain_db": 6.0,
      "timecode_offset_frames": 2
    },
    "16bit": {
      "capture_gain_db": 6.0,
      "timecode_offset_frames": 2
    }
  },
  "hdmi_display": {
    "width": 1920,
    "height": 1080,
    "mirror_to_both_ports": false,
    "overlays": {
      "buffer_vu_meter": true,
      "vu_meter_hatch_lines": true
    },
    "preview": {
      "default_zoom": 1.0,
      "zoom_steps": [1.0, 1.5, 2.0],
      "default_hdmi_source": "both",
      "anamorphic": {
        "default_factor": 1,
        "steps": [1, 1.33, 2.0]
      }
    }
  },
  "hardware_controls": {
    "buttons": [
      {
        "pin": 7,
        "pull_up": true,
        "debounce_time": 0.1,
        "press_action": { "method": "rec" }
      },
      {
        "pin": 10,
        "pull_up": true,
        "debounce_time": 0.1,
        "press_action": { "method": "rec" }
      },
      {
        "pin": 13,
        "pull_up": false,
        "debounce_time": 0.1,
        "press_action": "None",
        "single_click_action": { "method": "set_resolution" },
        "double_click_action": { "method": "restart_cinemate" },
        "triple_click_action": { "method": "reboot" },
        "hold_action": { "method": "toggle_mount" }
      }
    ],
    "two_way_switches": [
      {
        "pin": 24,
        "state_on_action": { "method": "set_zoom", "args": [2] },
        "state_off_action": { "method": "set_zoom", "args": [1] }
      },
      {
        "pin": 22,
        "state_on_action": { "method": "set_shutter_a_sync_mode", "args": [1] },
        "state_off_action": { "method": "set_shutter_a_sync_mode", "args": [0] }
      }
    ],
    "rotary_encoders": [
      {
        "enabled": true,
        "clk_pin": 9,
        "dt_pin": 11,
        "button_pin": 10,
        "pull_up": true,
        "debounce_time": 0.05,
        "button_actions": {
          "press_action": { "method": "set_iso_lock" },
          "hold_action": "None"
        },
        "encoder_actions": {
          "rotate_clockwise": { "method": "inc_iso" },
          "rotate_counterclockwise": { "method": "dec_iso" }
        }
      }
    ]
  },
  "input_peripherals": {
    "pots": [
      { "channel": "None", "setting": "iso" },
      { "channel": "None", "setting": "shutter_a" },
      { "channel": "None", "setting": "fps" },
      { "channel": "None", "setting": "wb" }
    ],
    "quad_rotary_controller": {
      "enabled": true,
      "encoders": {
        "0": {
          "setting_name": "iso",
          "button": {
            "press_action": { "method": "set_zoom" },
            "hold_action": { "method": "safe_shutdown" }
          }
        },
        "1": {
          "setting_name": "shutter_a",
          "button": {
            "press_action": { "method": "set_shutter_a_sync_mode" }
          }
        },
        "2": {
          "setting_name": "fps",
          "button": {
            "press_action": { "method": "set_fps_double" }
          }
        },
        "3": {
          "setting_name": "wb",
          "button": {
            "press_action": "None",
            "single_click_action": { "method": "set_resolution" },
            "double_click_action": { "method": "restart_cinemate" },
            "triple_click_action": { "method": "reboot" },
            "hold_action": { "method": "toggle_mount" }
          }
        }
      }
    }
  },
  "hardware_outputs": {
    "rec_out_pin": [21],
    "rec_tone": {
      "pin": [18],
      "frequency_hz": 1000,
      "duty_cycle": 50,
      "relay_drop_frames": false
    }
  },
  "output_peripherals": {
    "oled": {
      "enabled": false,
      "width": 128,
      "height": 64,
      "font_size": 20,
      "values": ["iso", "tc_cam0", "RECORDING_TC"]
    }
  }
}
