{
  "$schema": "./settings.schema.json",

  // ── system: splash screen, network, storage behavior ─────────────────────
  "system": {
    "welcome": {
      "show": true,
      "message": "THIS IS A COOL MACHINE",
      "image": null // path to a bitmap logo, e.g. "/home/pi/welcome_image.bmp"; overrides "message" when set
    },
    "wifi_hotspot": {
      "name": "CinePi",
      "password": "11111111",
      // true: broadcast this hotspot on boot. false: Cinemate still serves
      // its web UI on wlan0/eth0 if that interface already has an IP.
      "enabled": true
    },
    "https": {
      // Serve the web UI over TLS instead of plain HTTP. Off by default, and
      // not simply "more secure": cinepi.local and the hotspot's 10.42.0.1
      // can never hold a publicly-trusted certificate, so this always means a
      // self-signed one and a browser interstitial on first visit.
      //
      // Turn it on when you need a secure browser context -- the RAW pane's
      // "download into a folder" uses the File System Access API, which
      // browsers only expose on a secure origin.
      //
      // The certificate is minted on first start if missing, and re-issued
      // when it expires. Relative paths resolve against the repo root.
      "enabled": false,
      "cert_file": "resources/certs/cinemate.crt",
      "key_file": "resources/certs/cinemate.key",
      "valid_days": 3650
    },
    "web_api": {
      // Wireless control API (ESP32/Pico/M5Stack etc. over the hotspot).
      "enabled": true,
      // Bearer token required on every request once non-empty. Leave "" only
      // on a trusted/isolated hotspot.
      "token": "",
      // false blocks format/erase/reboot/shutdown even with a valid token.
      "allow_destructive": false,
      "max_commands_per_sec": 20,
      "max_sse_clients": 4,
      "broadcast": {
        "enabled": true,
        "port": 8888,
        "hz": 5,
        "keys": [
          "is_recording", "iso", "fps", "shutter_a_actual",
          "recording_tc_tod", "space_left", "drop_frame_count", "is_mounted"
        ]
      }
    },
    "recovery": {
      // Standalone recovery console on its own root service, for when
      // Cinemate will not start. Reachable over the hotspot at
      // http://10.42.0.1:8080 -- see docs/recovery-console.md.
      // A missing "recovery" block behaves exactly as the values below.
      "enabled": true,
      "port": 8080,
      // Required on every mutating request once non-empty. Read-only pages
      // stay open so a locked-out operator can always still diagnose.
      "token": "",
      // false hides the config.txt editor entirely. Default false: a bad
      // config.txt can make the Pi unbootable, and nothing running on the
      // Pi can recover that.
      "allow_config_txt": false,
      // Seconds to confirm a config.txt change before it auto-reverts.
      "config_confirm_timeout_s": 300
    },
    "storage": {
      "auto_preroll": true, // warm media automatically before the first take; see docs/storage-preroll.md
      "recognized_ssds": []
    }
  },

  // ── sensors: per-sensor hardware ──────────────────────────────────────────
  "sensors": {
    "raw_buffer_count": 0,
    // Dual-sensor record policy. "follow_preview": recording follows the
    // HDMI preview -- a full-screen or pip-main sensor records alone,
    // side-by-side records both. "always_both": force both sensors every
    // take regardless of preview. A camera token on `rec` (rec cam0/cam1/
    // both) overrides either policy for one take. No effect with one sensor.
    "record_policy": "follow_preview",
    "cam0": {
      "geometry": {
        "rotate_180": false,
        "horizontal_flip": false,
        "vertical_flip": false
      },
      "output": {
        "hdmi_port": 0
      },
      "override_camera_name": true,
      "camera_name": "cinepi",
      // Holds the recorded cadence on the nominal fps for stable A/V sync.
      // Safe to leave on for --sync genlock rigs too.
      "phase_lock": true,
      "tuning_file_override": {
        "enabled": false,
        "path": "/home/pi/cinemate/resources/tuning_files/imx477.json"
      },
      // CineMate Log target: false (off, default) | true (on, mode's default
      // target) | 10 | 12 (on, forced target where the live bit depth
      // supports it). See docs/cinemate-log.md.
      "log_encode": false
    },
    "cam1": {
      "geometry": {
        "rotate_180": false,
        "horizontal_flip": false,
        "vertical_flip": false
      },
      "output": {
        "hdmi_port": 1
      },
      "override_camera_name": true,
      "camera_name": "cinepi",
      "phase_lock": true,
      "tuning_file_override": {
        "enabled": false,
        "path": "/home/pi/cinemate/resources/tuning_files/imx477.json"
      },
      "log_encode": false
    },
    // Sensor metadata database -- every mode each sensor supports (see
    // image_capture below for the filter that picks which ones show in the UI).
    "database_file": "resources/sensors.json"
  },

  // ── settings: frame-rate conform + flicker-free input + sync tuning ──────
  "settings": {
    "conform_frame_rate": 25,
    "light_hz": [50, 60], // mains frequencies to derive flicker-free shutter angles from
    "sync_tolerances": {
      "live_sync_warning_frames": 5,
      "live_sync_startup_guard_frames": 10,
      "final_sync_analysis_frames": 1,
      "tc_drop_jitter_frames": 1
    }
  },

  // ── arrays: one block per cycle-able camera parameter ─────────────────────
  // steps = the selectable table; free = step continuously instead, in units
  // of free_increment (e.g. 0.1 for fine sub-degree shutter-angle control).
  "arrays": {
    "iso": {
      "steps": [100, 200, 400, 640, 800, 1200, 1600, 2500, 3200],
      "free": false,
      "free_increment": 100
    },
    "shutter_a": {
      "steps": [1, 45, 90, 135, 172.8, 180, 225, 270, 315, 346.6, 360],
      "free": true,
      "free_increment": 1,
      // Separate, finer granularity used only while `set shutter a sync` is
      // on -- sync mode tracks exposure time continuously across fps
      // changes, so it keeps its own default independent of free_increment.
      "sync_increment": 0.1
    },
    "fps": {
      "steps": [25, 33, 50],
      "free": false,
      "free_increment": 1
    },
    "wb": {
      "steps": [3200, 4400, 5600],
      "free": true,
      "free_increment": 100
    },
    // ClearHDR live knobs -- ranges per the imx585 driver: thresholds
    // 0-4095 each, blend mode 0-8, gain adder 0-5. See image_capture.hdr
    // below for their startup values.
    "hdr_threshold_low": {
      "steps": [0, 512, 1024, 1536, 2048, 2560, 3072, 3584, 4095],
      "free": false,
      "free_increment": 16
    },
    "hdr_threshold_high": {
      "steps": [0, 512, 1024, 1536, 2048, 2560, 3072, 3584, 4095],
      "free": false,
      "free_increment": 16
    },
    "hdr_blend": {
      "steps": [0, 1, 2, 3, 4, 5, 6, 7, 8],
      "free": false,
      "free_increment": 1
    },
    "hdr_gain_adder": {
      "steps": [0, 1, 2, 3, 4, 5],
      "free": false,
      "free_increment": 1
    }
  },

  // ── image_capture: resolution / bit-depth / HDR filters ──────────────────
  "image_capture": {
    "k_steps": [1.5, 2, 3, 4],
    "bit_depths": [10, 12, 16],
    "hdr": {
      // ClearHDR (imx585) whitelist. Both true exposes the plain and the
      // HDR modes; set "imx585_clear_hdr" false to hide the HDR modes.
      "sdr": true,
      "imx585_clear_hdr": true,
      // Startup values for the ClearHDR live knobs (0-4095 / 0-8 / 0-5).
      // Applied when a ClearHDR mode is selected; adjust live afterwards
      // with `set hdr threshold low/high`, `set hdr blend`, `set hdr gain
      // adder`, or a pot/quad-rotary channel. HG 1/16 + LG 15/16 blend
      // (menu 5), +6 dB gain adder (menu 1) -- a lower noise floor than the
      // driver's +12 dB default.
      //
      // null on the two thresholds means "leave the sensor driver's own
      // pair alone" (EXP_TH_H 0x0FFF, EXP_TH_L 0x0000). Do not set both to
      // the same value: equal thresholds select the AppNote's weighted-blend
      // fallback, where the ClearHDR combiner output stays clamped near the
      // black level and every HDR frame comes out flat. Set both, or
      // neither.
      "threshold_low": null,
      "threshold_high": null,
      "blend": 5,
      "gain_adder": 1,
      // Automatic recovery from the flat-pedestal ClearHDR startup defect
      // (round 8, 2026-08-29): probe the live preview after every launch and,
      // if it looks flat, try a brief shutter-angle kick and then a bounded
      // mode bounce. Default false, deliberately.
      //
      // The root cause is still unknown, and every action this can take is
      // unproven on hardware: the mode bounce and an earlier gain shock were
      // both live-tested and failed, and the shutter kick's automated form has
      // never run on the rig (only the manual shutter-to-1-degree version is
      // operator-confirmed). The detector cannot tell the defect from a
      // genuinely flat scene -- a lens cap or an unlit set shares the same
      // low-unique-value signature -- so a false positive costs roughly two
      // extra start_all() cycles (~6-10 s) at an arbitrary moment.
      //
      // Turn this on only to reproduce or study the defect. See
      // development/mono-clearhdr-fixes/ROUND9-RESULTS.md.
      "self_heal": false
    },
    // Embedded DNG thumbnail written by cinepi-raw's DNG encoder: 0 off,
    // 1 mono, 2 colour (`set thumbnail`, live, no camera restart). Colour
    // by default -- verified on hardware (G10/G11) and the standard
    // playback path; raw decode is far more demanding on the Pi and is no
    // longer the pane's fallback. New takes only.
    "thumbnail": 2,
    "custom_modes": {}
  },

  // ── audio_capture: capture gain + timecode offset, per mic path ──────────
  "audio_capture": {
    // Applies when the mic supports 24-bit stereo capture (mic_24bit alias).
    "24bit": {
      "capture_gain_db": 6.0,
      "timecode_offset_frames": 2
    },
    // Applies when only 16-bit mono is available (mic_16bit alias).
    "16bit": {
      "capture_gain_db": 6.0,
      "timecode_offset_frames": 2
    }
  },

  // ── hdmi_display: HDMI canvas, GUI overlays, preview ──────────────────────
  "hdmi_display": {
    "width": 1920,
    "height": 1080,
    // Single-sensor only: mirror the one sensor's preview (with GUI) onto
    // BOTH HDMI connectors. The dual-sensor compositor already owns
    // both-feed layouts, so this has no effect with two sensors attached.
    "mirror_to_both_ports": false,
    "overlays": {
      "buffer_vu_meter": true,
      "vu_meter_hatch_lines": true
    },
    "preview": {
      "default_zoom": 1.0,
      "zoom_steps": [1.0, 1.5, 2.0],
      // Dual-sensor HDMI preview source at startup: both | cam0 | cam1 |
      // pip_cam0 | pip_cam1. Switch live with `set preview`. No effect with
      // a single sensor.
      "default_hdmi_source": "both",
      "pip": {
        "scale": 0.28,
        "corner": "lower_right",
        "margin": 0.03
      },
      "anamorphic": {
        "default_factor": 1,
        "steps": [1, 1.33, 2.0]
      }
    }
  },

  // ── hardware_controls: GPIO buttons, switches, rotary encoders ───────────
  "hardware_controls": {
    "buttons": [
      {
        "pin": 7,
        "pull_up": true,
        "debounce_time": 0.1,
        "press_action": { "method": "rec" }
      },
      {
        "pin": 10,
        "pull_up": true,
        "debounce_time": 0.1,
        "press_action": { "method": "rec" }
      },
      {
        "pin": 13,
        "pull_up": false,
        "debounce_time": 0.1,
        "press_action": "None",
        "single_click_action": { "method": "set_resolution" },
        "double_click_action": { "method": "restart_cinemate" },
        "triple_click_action": { "method": "reboot" },
        "hold_action": { "method": "toggle_mount" }
      }
    ],
    "two_way_switches": [
      {
        "pin": 24,
        "state_on_action": { "method": "set_zoom", "args": [2] },
        "state_off_action": { "method": "set_zoom", "args": [1] }
      },
      {
        "pin": 22,
        "state_on_action": { "method": "set_shutter_a_sync_mode", "args": [1] },
        "state_off_action": { "method": "set_shutter_a_sync_mode", "args": [0] }
      }
    ],
    "three_way_switches": [],
    // "enabled": false ships this as a template -- it won't claim clk_pin/
    // dt_pin/button_pin at startup. Set it true (and wire the pins) to use it.
    "rotary_encoders": [
      {
        "enabled": true,
        "clk_pin": 9,
        "dt_pin": 11,
        "button_pin": 10,
        "pull_up": true,
        "debounce_time": 0.05,
        "button_actions": {
          "press_action": { "method": "set_iso_lock" },
          "hold_action": "None"
        },
        "encoder_actions": {
          "rotate_clockwise": { "method": "inc_iso" },
          "rotate_counterclockwise": { "method": "dec_iso" }
        }
      }
    ],
    "combined_actions": []
  },

  // ── input_peripherals: Grove Base HAT pots + quad I2C rotary board ───────
  "input_peripherals": {
    // Grove Base HAT analog pots. "channel" is the ADC channel number (0-7);
    // "None" means no pot wired for that setting -- set a real channel
    // number to enable it. "setting" must match a name in `arrays` above
    // (iso, shutter_a, fps, wb, hdr_threshold_low, hdr_threshold_high,
    // hdr_blend, hdr_gain_adder).
    "pots": [
      { "channel": "None", "setting": "iso" },
      { "channel": "None", "setting": "shutter_a" },
      { "channel": "None", "setting": "fps" },
      { "channel": "None", "setting": "wb" },
      { "channel": "None", "setting": "hdr_threshold_low" },
      { "channel": "None", "setting": "hdr_threshold_high" },
      { "channel": "None", "setting": "hdr_blend" },
      { "channel": "None", "setting": "hdr_gain_adder" }
    ],
    // Adafruit Quad Rotary Encoder (Neopixel I2C breakout).
    "quad_rotary_controller": {
      "enabled": true,
      "encoders": {
        "0": {
          "setting_name": "iso",
          "button": {
            "press_action": { "method": "set_zoom" },
            "hold_action": { "method": "safe_shutdown" }
          }
        },
        "1": {
          "setting_name": "shutter_a",
          "button": {
            "press_action": { "method": "set_shutter_a_sync_mode" }
          }
        },
        "2": {
          "setting_name": "fps",
          "button": {
            "press_action": { "method": "set_fps_double" }
          }
        },
        "3": {
          "setting_name": "wb",
          "button": {
            "press_action": "None",
            "single_click_action": { "method": "set_resolution" },
            "double_click_action": { "method": "restart_cinemate" },
            "triple_click_action": { "method": "reboot" },
            "hold_action": { "method": "toggle_mount" }
          }
        }
      }
    }
  },

  // ── hardware_outputs: GPIO outputs Cinemate drives ────────────────────────
  "hardware_outputs": {
    "rec_out_pin": [21],
    "rec_tone": {
      "pin": [18],
      "frequency_hz": 1000,
      "duty_cycle": 50,
      "relay_drop_frames": false
    }
  },

  // ── output_peripherals: the optional I2C OLED status screen ──────────────
  "output_peripherals": {
    "oled": {
      "enabled": false,
      "width": 128,
      "height": 64,
      "font_size": 20,
      "values": ["iso", "tc_cam0", "RECORDING_TC"]
    }
  }
}
